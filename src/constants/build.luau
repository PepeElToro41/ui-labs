--[[
	Build information, generated by `zune run scripts/build-info.luau`.

	The committed values describe a local build. CI regenerates this file before
	building, with the channel and the commit it publishes from.
]]

export type Channel = "dev" | "canary" | "release"

export type Version = {
	mayor: number,
	minor: number,
	fix: number,
}

export type Build = {
	channel: Channel,
	version: Version,
	--- short hash of the commit the build was made from, nil for local builds
	commit: string?,
}

local BUILD: Build = {
	channel = "dev",
	version = { mayor = 2, minor = 0, fix = 0 },
	commit = nil,
}

return BUILD
